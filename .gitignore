# yui per-machine state and backups (regenerable, do not commit)
# .yui/bin/ contains hook scripts and IS committed.
/.yui/state.json
/.yui/state.json.tmp
/.gitignore.tmp
/.yui/backup/

# >>> yui rendered (auto-managed, do not edit) >>>
home/.config/gcal/credentials.json
home/.config/gogcli/credentials.json
home/.config/gogcli/keyring/token%3Adefault%3Ayukimemi@gmail.com
home/.config/gogcli/keyring/token%3Ayukimemi@gmail.com
home/.config/google-calendar-mcp/tokens.json
home/.config/herdr/config.toml
home/.config/kanade/nats-users/agent.hash
home/.config/kanade/nats-users/agent.pw
home/.config/kanade/nats-users/backend.hash
home/.config/kanade/nats-users/backend.pw
home/.config/kanade/nats-users/breakglass.hash
home/.config/kanade/nats-users/breakglass.pw
home/.config/kanade/oci.env
home/.config/magi/icons/asuka.png
home/.config/magi/icons/default.png
home/.config/magi/icons/kaworu.png
home/.config/magi/icons/magi.png
home/.config/magi/icons/misato.png
home/.config/magi/icons/rei.png

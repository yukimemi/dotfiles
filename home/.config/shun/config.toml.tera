# shun config. Managed by yui (rendered from config.toml.tera).
#
# yui renders the per-machine parts — F11 browser from yui `vars.browser`,
# F9 Excel from `vars.excel`; set them in ~/dotfiles/config.local.toml.
# Everything after the `raw` marker passes through untouched, so shun's own
# template tokens (os, vars.*, args) resolve at shun load time.

auto_start = true
sort_order = "recent_first"
search_mode = "fuzzy_migemo"
hide_on_blur = true
window_width = 700
max_items = 10
max_completions = 8
opacity = 0.9
icon_style = "svg"
preview_args = true
preview_search = true

# /config and /history open through todoke instead of the OS file
# association (which needs `.toml` etc. registered via duti/LaunchServices).
editor_command = "todoke"

[vars]
memo_path = "~/.memolist"
junk_path = "~/.cache/junkfile"
src_path = "~/src"

[log]
level = "debug"

[keybindings]
launch = "Ctrl+Enter"
next = "Ctrl+n"
prev = "Ctrl+p"
confirm = "Enter"
arg_mode = "Tab"
accept_word = "Ctrl+f"
accept_line = "Ctrl+e"
delete_word = "Ctrl+w"
delete_line = "Ctrl+u"
close = "Escape"

[theme]
preset = "tokyo-night"

[[apps]]
name = "Neovide"
path = "todoke"
window_exe = "Neovide"
completion = "path"
hotkey = "F10"
hotkey_mode = "activate"

[[apps]]
name = "Outlook"
path = "olk"
hotkey = "Ctrl+F9"
hotkey_mode = "activate"

[[apps]]
name = "Teams"
path = "ms-teams"
hotkey = "Ctrl+F12"
hotkey_mode = "activate"

# F11 browser, picked per machine by yui `vars.browser`.
[[apps]]
{%- if vars.browser == "brave" %}
name = "Brave"
path = "brave"
{%- elif vars.browser == "chrome" %}
name = "Google Chrome"
path = "chrome"
{%- elif vars.browser == "comet" %}
name = "Comet"
path = "comet"
{%- elif vars.browser == "edge" %}
name = "Microsoft Edge"
path = "msedge"
# Installed PWAs run as msedge.exe too; only real browser windows carry "Edge".
window_title = "Edge"
{%- else %}
{{ throw(message="vars.browser must be edge | brave | chrome | comet, got: " ~ vars.browser) }}
{%- endif %}
hotkey = "F11"
hotkey_mode = "activate"

{%- if vars.excel %}
# F9 Excel, only on machines with yui `vars.excel = true`.
[[apps]]
name = "Excel"
path = "C:/Program Files/Microsoft Office/root/Office16/EXCEL.EXE"
hotkey = "F9"
hotkey_mode = "activate"

{% endif -%}
{% raw -%}
# OS-conditional: Windows Terminal (Windows) / WezTerm (macOS) share the F12 toggle
# and Ctrl+F10 "open yazi" hotkeys. `os` is resolved from `std::env::consts::OS` at
# config-load time, so only the matching OS's hotkey is valid; the other renders to
# an empty string and is silently skipped as an invalid shortcut (logged as a warning).
#
# NOTE: on Windows the window belongs to WindowsTerminal.exe while "wtp" is only a
# launcher, so `window_exe` tells activate/toggle which process to match.
[[apps]]
name = "Windows Terminal"
path = "wtp"
window_exe = "WindowsTerminal"
window_title_exclude = "Yazi"
hotkey = "{% if os == \"windows\" %}F12{% endif %}"
hotkey_mode = "toggle"

# macOS: `name` must be the exact .app bundle name for the AppleScript-based
# activate/toggle match (see README "Per-app global hotkeys" macOS row).
[[apps]]
name = "WezTerm"
path = "wezterm-gui"
hotkey = "{% if os == \"macos\" %}F12{% endif %}"
hotkey_mode = "toggle"

# yazi: its own named Windows Terminal window ("-w yazi") with a fixed title, so
# window_exe + window_title find it and Ctrl+F10 activates it instead of stacking tabs.
[[apps]]
name = "yazi (Windows Terminal)"
path = "wtp"
args = ["-w", "yazi", "new-tab", "--title", "Yazi", "--suppressApplicationTitle", "yazi"]
window_exe = "WindowsTerminal"
window_title = "Yazi"
hotkey = "{% if os == \"windows\" %}Ctrl+F10{% endif %}"
hotkey_mode = "activate"

[[apps]]
name = "yazi (WezTerm)"
path = "wezterm-gui"
args = ["start", "--", "yazi"]
hotkey = "{% if os == \"macos\" %}Ctrl+F10{% endif %}"

[[apps]]
name = "Slack"
path = "slack"
hotkey = "Ctrl+F11"
hotkey_mode = "activate"

[[apps]]
name = "YaibaStart"
path = "conhost"
args = ["--headless", "yaiba", "--update", "off", "--relay-only"]

[[apps]]
name = "YaibaStop"
path = "powershell"
args = [
  "-NoProfile",
  "-Command",
  "Stop-Process -Name yaiba -ErrorAction SilentlyContinue",
]

[[apps]]
name = "YaibaRestart"
path = "powershell"
args = [
  "-NoProfile",
  "-Command",
  "Stop-Process -Name yaiba -ErrorAction SilentlyContinue; yaiba",
]

[[apps]]
name = "Todo"
path = "todoke"
args = ["{{ vars.memo_path }}/todo.md"]

[[apps]]
name = "Open Project"
path = "neovide"
args = ["{{ vars.src_path }}/{{ args }}"]
completion = "path"

[[apps]]
name = "MemoNew"
path = "todoke"
args = [
  '{{ vars.memo_path }}/{{ now() | date(format="%Y-%m-%d") }}-{{ args }}.md',
]
completion = "none"

[[apps]]
name = "MemoList"
path = "todoke"
args = ["{{ vars.memo_path }}/{{ args }}"]
completion = "path"
completion_search_mode = "migemo"

[[apps]]
name = "JunkNew"
path = "todoke"
args = [
  '{{ vars.junk_path }}/{{ now() | date(format="%Y") }}/{{ now() | date(format="%m") }}/{{ now() | date(format="%Y-%m-%d") }}-{{ now() | date(format="%H%M%S") }}.{{ args }}',
]
completion = "none"

[[apps]]
name = "Scoop"
path = "scoop"
completion = "list"
completion_list = [
  "install",
  "uninstall",
  "update",
  "search",
  "list",
  "info",
  "status",
  "cleanup",
  "bucket",
  "cache",
  "checkup",
  "config",
  "hold",
  "unhold",
  "reset",
  "shim",
  "which",
]

[[apps]]
name = "Git"
path = "git"
completion = "command"
completion_command = "git branch --format='%(refname:short)'"
workdir = "{{ vars.src_path }}/github.com/yukimemi/shun"

[[apps]]
name = "Rakuten Affiliate report"
path = "https://affiliate.rakuten.co.jp/report"

[[apps]]
name = "ccusage"
path = "https://claude.ai/settings/usage"

[[apps]]
name = "gptusage"
path = "https://chatgpt.com/profile#settings/Usage"

[[apps]]
name = "kimiusage"
path = "https://www.kimi.com/code/console"

[[apps]]
name = "deepseekusage"
path = "https://platform.deepseek.com/usage"

[[apps]]
name = "Google"
path = "https://www.google.com/search?q={{ args | urlencode }}"

[[apps]]
name = "M365 Copilot"
path = "https://m365.cloud.microsoft"

[[apps]]
name = "GitHub Search"
path = "https://github.com/search?q={{ args | urlencode }}"

[[apps]]
name = "Perplexity"
path = "https://www.perplexity.ai/search?q={{ args | urlencode }}"

[[apps]]
name = "Amazon"
path = "https://www.amazon.co.jp/s?k={{ args | urlencode }}&sort=salesrank&s=review-rank"

[[apps]]
name = "YouTube"
path = "https://www.youtube.com/results?search_query={{ args | urlencode }}"

[[apps]]
name = "Zenn"
path = "https://zenn.dev/search?q={{ args | urlencode }}"

[[apps]]
name = "Qiita"
path = "https://qiita.com/search?q={{ args | urlencode }}"

[[apps]]
name = "Stack Overflow"
path = "https://stackoverflow.com/search?q={{ args | urlencode }}"

[[apps]]
name = "crates.io"
path = "https://crates.io/search?q={{ args | urlencode }}"

[[apps]]
name = "npm"
path = "https://www.npmjs.com/search?q={{ args | urlencode }}"

[[apps]]
name = "JSR"
path = "https://jsr.io/?search={{ args | urlencode }}"

[[apps]]
name = "DeepL ja->en"
path = "https://www.deepl.com/translator#ja/en/{{ args | urlencode }}"

[[apps]]
name = "DeepL en->ja"
path = "https://www.deepl.com/translator#en/ja/{{ args | urlencode }}"

[[apps]]
name = "Wikipedia"
path = "https://ja.wikipedia.org/wiki/Special:Search?search={{ args | urlencode }}"

[[apps]]
name = "Docker Hub"
path = "https://hub.docker.com/search?q={{ args | urlencode }}"

[[apps]]
name = "X"
path = "https://x.com/search?q={{ args | urlencode }}"

[[scan_dirs]]
path = "{{ vars.src_path }}/github.com/yukimemi/ps1/src"
recursive = false
extensions = ["ps1"]

[[scan_dirs]]
path = "~/scoop/persist/rustup-msvc/.cargo/bin"
recursive = false
extensions = ["exe"]

[[scan_dirs]]
path = "~/scoop/persist/rustup-gnu/.cargo/bin"
recursive = false
extensions = ["exe"]

[[scan_dirs]]
path = "~/dotfiles/.yui/bin"
recursive = true
extensions = ["ps1"]

[[scan_dirs]]
path = "C:/Windows/System32"
recursive = false
extensions = ["exe"]

[[apps]]
name = "Get-DriveInfoView"
path = "powershell"
args = [
  "-NoProfile",
  "-Command",
  '''
  try {
    function Get-DriveInfo {
      Get-PSDrive -PSProvider FileSystem | Where-Object { $_.Used -and $_.Name -ne "Temp" } | Sort-Object Name
    }

    function Get-DriveInfoView {
      Get-DriveInfo | Format-Table -AutoSize
    }
    Get-DriveInfoView
  } catch {
    Write-Host "$_ | Out-String"
  } finally {
    Read-Host "Press any key ..."
  }
''',
]

[[apps]]
name = "Edge - Insecure origins treated as secure"
path = "msedge"
args = ['edge://flags/#unsafely-treat-insecure-origin-as-secure']
{% endraw -%}

# ~/.codex is junctioned here as a whole (see config.toml).
# Keep settings and custom skills; let new configuration files surface.

# Credentials and machine identity
/auth.json
/cap_sid
/installation_id
/.sandbox-secrets/

# App state, history, and databases
/.codex-global-state.json*
/.sandbox_migration
/history.jsonl
/session_index.jsonl
/sessions/
/archived_sessions/
/sqlite/
/*.sqlite*
/*.db
/*.db-shm
/*.db-wal
/thread-writer-locks/
/ambient-suggestions/
/claude-cowork-transcript-imports/
/claude-cowork-import-history.json
/external_agent_session_imports.json
/realtime-voice-continuity.json

# Logs, caches, temporary files, and downloaded runtimes
/*.log*
/*.bak
/log/
/logs/
/cache/
/.tmp/
/tmp/
/.sandbox/
/.sandbox-bin/
/computer-use/
/editor/
/vendor_imports/
/models_cache.json
/version.json

# Managed plugins and bundled skills (regenerated by Codex)
/plugins/cache/
/plugins/.plugin-appserver*
/plugins/.remote-plugin-*
/skills/.system/

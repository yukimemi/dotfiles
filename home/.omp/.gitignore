# ~/.omp is junction'd here as a whole (see .yuilink), so every runtime
# artifact omp writes lands in this tree. Deny-list on purpose: anything
# omp starts writing that isn't listed shows up as untracked, so a new
# config file gets noticed and judged instead of silently ignored.
#
# (keep agent/config.yml)

/install-id
/gpu_cache.json

/agent/agent.db
/agent/agent.db-shm
/agent/agent.db-wal
/agent/history.db
/agent/history.db-shm
/agent/history.db-wal
/agent/models.db
/agent/models.db-shm
/agent/models.db-wal
/agent/kimi-device-id
/agent/last-changelog-version
/agent/settings.json.bak
/agent/blobs/
/agent/memories/
/agent/sessions/
/agent/terminal-sessions/

/browser-relay/
/cache/
/logs/
/natives/
/puppeteer/
/run/

# ~/.gemini is junction'd here as a whole (see [[link]] in config.toml),
# so every runtime artifact the Gemini CLI writes lands in this tree.
# Deny-list on purpose: anything not listed shows up as untracked, so a
# new config file gets noticed and judged instead of silently ignored.
#
# (keep GEMINI.md)

# credentials — never commit
/oauth_creds.json
/google_accounts.json
/gemini-credentials.json

# antigravity IDE / CLI payload (~230MB, redownloadable)
/antigravity/
/antigravity-cli/bin/
/antigravity-cli/builtin/
/antigravity-cli/updater/

# antigravity-cli runtime state & history
/antigravity-cli/annotations/
/antigravity-cli/brain/
/antigravity-cli/cache/
/antigravity-cli/conversations/
/antigravity-cli/crashes/
/antigravity-cli/implicit/
/antigravity-cli/log/
/antigravity-cli/presence/
/antigravity-cli/cli.log
/antigravity-cli/history.jsonl
/antigravity-cli/installation_id
/antigravity-cli/last_check.timestamp
/antigravity-cli/conversation_summaries.db*
/antigravity-cli/jetbox_summaries_proto.pb
/antigravity-cli/jetski_state.pbtxt

# runtime state
/history/
/installation_id
/projects.json
/state.json
/trustedFolders.json
/tmp/

# per-project session state — regenerated per workspace
/config/projects/
/config/.migrated
